{
  "name": "youtube-speed-tool",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "test": "node --test 'tests/*.test.mjs'",
    "lint": "web-ext lint --source-dir src",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest",
    "icons": "python3 scripts/make-icons.py",
    "store-assets": "node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "husky": "9.1.7",
    "playwright": "1.64.1",
    "puppeteer-core": "24.43.1",
    "web-ext": "10.8.0"
  }
}
